# build context is the repo root (go.mod lives there)

FROM golang:1.25-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/coordinator ./checker/cmd/coordinator

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=builder /out/coordinator /app/bin/coordinator

ENTRYPOINT ["/app/bin/coordinator"]
