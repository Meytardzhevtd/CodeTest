# build context is the repo root (go.mod lives there, server/migrations
# is read via a path relative to the working directory at runtime)

FROM golang:1.25-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/server ./server/cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=builder /out/server /app/bin/server
COPY --from=builder /app/server/migrations /app/server/migrations

ENTRYPOINT ["/app/bin/server"]
